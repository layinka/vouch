# ---- Hedera testnet (get these from https://portal.hedera.com) ----
# IMPORTANT: create an ECDSA account, NOT ED25519.
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=0x...
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Optional: a SECOND account to act as the buyer agent, so the demo shows a
# transfer between two distinct parties. Falls back to the account above.
# HEDERA_BUYER_ACCOUNT_ID=0.0.yyyyyyy
# HEDERA_BUYER_PRIVATE_KEY=0x...

# ---- x402 ----
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# USDC on Hedera testnet (6 decimals). Use 0.0.0 for HBAR (no association needed).
X402_ASSET=0.0.429274
X402_PAY_TO=
# smallest units: USDC 1000 = $0.001 | HBAR 100000 tinybars = 0.001 HBAR
X402_PRICE_SCORE=1000

PORT=3000

# ---- The Graph (free: thegraph.com/studio -> connect wallet -> API Keys) ----
# Free plan: 100k queries/month. Studio dev endpoint: 3,000 queries/day.
# Set a $0 spending limit on the key so it can never bill you.
SUBGRAPH_API_KEY=
SUBGRAPH_URL=

# ---- Sepolia (ENSv2 + ERC-8004 + Vouch contracts + the subgraph) ----
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
# The ONLY key permitted to write agent:score on the PermissionedResolver
SCORER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
VOUCH_PARENT_NAME=
