{
  "name": "vouch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spike:env": "node --env-file-if-exists=.env spike/00-check-env.ts",
    "spike:assoc": "node --env-file-if-exists=.env spike/01-associate-usdc.ts",
    "spike:server": "node --env-file-if-exists=.env --watch spike/02-server.ts",
    "spike:client": "node --env-file-if-exists=.env spike/03-client.ts",
    "typecheck": "tsc --noEmit",
    "spike:buyer": "node --env-file-if-exists=.env spike/01b-create-buyer.ts",
    "spike:graph": "node --env-file-if-exists=.env spike/05-check-graph.ts",
    "keys:gen": "node --env-file-if-exists=.env spike/06-gen-sepolia-keys.ts",
